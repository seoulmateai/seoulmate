# ---------------------------------------------------------------
# 이 파일을 .env.local 로 복사해서 값을 채우세요.  (cp .env.example .env.local)
# NEXT_PUBLIC_ 접두사가 붙은 값만 브라우저에 노출됩니다.
# ---------------------------------------------------------------

# 사이트 URL (OAuth/이메일 인증 리다이렉트에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://bywzioymcdbqwqsjbyqd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용! RLS를 우회합니다. 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 캐릭터 캐시 무효화 Webhook 시크릿 (Supabase Database Webhook 헤더 x-revalidate-secret와 동일하게)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHARACTERS_REVALIDATE_SECRET=

# Cloudflare R2 공개 버킷 URL (캐릭터 이미지). 끝에 / 없이
NEXT_PUBLIC_R2_PUBLIC_URL=

# Cloudflare R2 — 채팅 이미지 비공개 버킷 (서버 전용! NEXT_PUBLIC_ 붙이지 말 것)
# R2 > Manage R2 API Tokens: Object Read & Write, 이 버킷만
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CHAT_IMAGES_BUCKET=seoulmate-chat-images

# Gemini — 서버 전용 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# 별칭이 아닌 고정 버전명 권장 (llm_calls.model에 기록됨)
GEMINI_MODEL=gemini-3.5-flash-lite

# 무료 사용자 일일 답변 한도 (consume_reply_quota에 전달)
FREE_DAILY_REPLY_LIMIT=10
# 구독자 일일 답변 한도
PAID_DAILY_REPLY_LIMIT=15

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stripe (테스트 모드) — 서버 전용! NEXT_PUBLIC_ 붙이지 말 것
# STRIPE_SECRET_KEY + STRIPE_PRICE_ID 가 둘 다 있을 때만 결제 기능이 켜짐 (lib/billing/config.ts)
# Production에는 넣지 말 것. Vercel은 Preview 환경 + feat/billing 브랜치에만 지정
# 로컬 webhook secret은 `stripe listen` 이 출력하는 값 (대시보드 endpoint secret과 다름)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
